# Copy to /etc/fhl-vault.env (setup_server.sh does this for you), mode 600, owner root. NEVER commit the real file.
DATABASE_URL=postgresql://fhl:CHANGE_ME@127.0.0.1/fhl
COOKIE_SECURE=true

# One-time code sign-in
OTP_PEPPER=CHANGE_ME_long_random_secret          # python3 -c "import secrets;print(secrets.token_urlsafe(48))"
OTP_ALLOWED_DOMAINS=fiberathome.net              # only these email domains can ever receive a code
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5

# Outgoing mail (use the details of your no-reply mailbox)
# On Vercel (no outbound SMTP) set BREVO_API_KEY instead; codes are then sent over HTTPS and the SMTP_* values are unused.
# BREVO_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURITY=ssl                                # ssl (port 465) | starttls (port 587)
SMTP_USER=no-reply@fiberathome.net
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=Fiber@Home Knowledge Vault <no-reply@fiberathome.net>

SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=30
